# TestNG runs through Surefire, on the JUnit Platform since Surefire 3.6.0,
# and through Gradle's useTestNG(). Both write JUnit XML beside TestNG's own
# testng-results.xml, which the check does not read.
# cspell:ignore testng
name: TestNG
group: org.testng
import: org.testng
hint: Gradle runs TestNG tests only when the test task calls useTestNG()
# @Test on a class runs each of its public methods as a test, but not the
# @BeforeTest and @AfterTest setup methods, which carry their own marks.
tests: Test
classes: Test
