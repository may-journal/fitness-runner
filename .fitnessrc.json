{
  "checks": [
    "read-repo-first",
    "changelog",
    "changelog-updated",
    "cspell",
    "eslint",
    "markdown-no-bold-italic",
    "prettier",
    "node-version",
    "markdown-front-matter",
    "semantic-commit",
    "jscpd",
    "mermaid-callouts",
    "mermaid-callout-why",
    "mermaid-diagram-prose",
    "mermaid-legend",
    "mermaid-level-bleed",
    "dependency-currency",
    "gitignore-why",
    "markdown-filename-kebab-case",
    "build-output-untracked",
    "repeated-string-literals"
  ],
  "repeatedStringLiterals": {
    "allow": ["dist", "eslint", "jscpd", "package.json"]
  }
}
