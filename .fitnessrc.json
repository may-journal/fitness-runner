{
  "checks": [
    "read-repo-first",
    "changelog",
    "changelog-updated",
    "changelog-bullets",
    "cspell",
    "markdown-no-bold-italic",
    "markdown-front-matter",
    "semantic-commit",
    "jscpd",
    "mermaid-callouts",
    "mermaid-callout-why",
    "mermaid-diagram-prose",
    "mermaid-legend",
    "mermaid-level-bleed",
    "gitignore-why",
    "markdown-filename-kebab-case",
    "markdown-links",
    "build-output-untracked",
    "repeated-string-literals",
    "go-complexity",
    "text-readability",
    "prose-budget",
    "no-plans-dir",
    "plan-trailer"
  ],
  "disabledChecks": [
    "eslint",
    "no-eslint-disable",
    "prettier",
    "node-version",
    "dependency-currency",
    "vitest-coverage-exclude",
    "vitest-coverage-full"
  ],
  "textReadability": {
    "maxGrade": 15,
    "maxLix": 50
  },
  "proseBudget": {},
  "repeatedStringLiterals": {
    "allow": [
      "dist",
      "eslint",
      "jscpd",
      "package.json"
    ]
  }
}
