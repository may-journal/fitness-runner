#!/usr/bin/env bash
# The Go hook blocks a push whose branch has an open PR closing no
# approved Plan, except chore and docs pushes. It needs the `gh` CLI to
# read the PR and approval.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
FITNESS_CHECKS_DIR="$(githooks/checks-dir)"
export FITNESS_CHECKS_DIR
exec go/bin/fitness hook pre-push
