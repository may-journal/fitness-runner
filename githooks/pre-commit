#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Build the toolchain (fast when warm) and gate the commit on the fitness
# suite. The suite's gofmt, go-vet, and go-test checks cover the CI gate, so
# `make check` is not run twice. exec keeps git as the parent process, so
# the hook can tell an amend apart.
make build
exec go/bin/fitness hook pre-commit
