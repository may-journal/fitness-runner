#!/usr/bin/env bash
# Delegates to the same Go hook every consumer repo runs: semantic-commit,
# plan-trailer, issue-link-once, and requirements-changed. exec keeps git as
# the parent process, so the hook can tell an amend apart.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
FITNESS_CHECKS_DIR="$(githooks/checks-dir)"
export FITNESS_CHECKS_DIR
exec go/bin/fitness hook commit-msg "$1"
