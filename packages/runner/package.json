{
  "name": "@mayjournal/fitness",
  "version": "0.1.0-2026.07.06.1502",
  "description": "Node fitness runner that runs checks so local dev, CI/CD, and GenAI workflows stay aligned with your intended rules and quality bar.",
  "keywords": [
    "cli",
    "lint",
    "checks",
    "quality",
    "ci",
    "pre-commit",
    "fitness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/may-journal/fitness-runner.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.types.d.ts",
      "import": "./dist/types/index.types.js",
      "default": "./dist/types/index.types.js"
    },
    "./runner": {
      "types": "./dist/runner/index.d.ts",
      "import": "./dist/runner/index.js",
      "default": "./dist/runner/index.js"
    }
  },
  "main": "dist/types/index.types.js",
  "types": "dist/types/index.types.d.ts",
  "bin": {
    "fitness": "bin/fitness.js"
  },
  "files": [
    "bin",
    "dist",
    "githooks"
  ],
  "scripts": {
    "bench": "npm run build && vitest bench --config vitest.bench.config.mjs",
    "build": "npm run build -w @mayjournal/fitness-shared && fitness-shared build",
    "ci": "bash ../../scripts/nvm-use/nvm-use.sh && npm run fitness",
    "fitness": "npm run build && node bin/fitness.js",
    "knip": "knip --no-exit-code",
    "lint": "fitness-shared lint .",
    "precommit": "npm run fitness",
    "prepublishOnly": "npm run build",
    "publish:ci": "npm publish",
    "test": "fitness-shared test --coverage"
  },
  "prettier": "@mayjournal/fitness-shared/prettier.config",
  "dependencies": {
    "@mayjournal/fitness-shared": "*",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "knip": {
    "entry": [
      "src/index.ts",
      "bin/fitness.js",
      "src/**/*.test.ts",
      "src/**/*.bench.ts"
    ],
    "project": [
      "src/**/*.ts",
      "bin/**/*.js"
    ]
  }
}
