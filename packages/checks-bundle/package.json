{
  "name": "@mayjournal/fitness-checks",
  "version": "0.1.0-2026.07.05.1946",
  "description": "Default check bundle for @mayjournal/fitness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/may-journal/fitness-runner.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./defaultChecks": {
      "types": "./dist/defaultChecks.d.ts",
      "import": "./dist/defaultChecks.js",
      "default": "./dist/defaultChecks.js"
    },
    "./checks/*": {
      "types": "./dist/checks/*/index.d.ts",
      "import": "./dist/checks/*/index.js",
      "default": "./dist/checks/*/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/bundle-check-dist.mjs && fitness-shared build",
    "knip": "knip --no-exit-code",
    "prepublishOnly": "npm run build",
    "publish:ci": "npm publish"
  },
  "prettier": "@mayjournal/fitness-shared/prettier.config",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "knip": {
    "entry": [
      "src/index.ts",
      "scripts/bundle-check-dist.mjs"
    ],
    "project": [
      "src/**/*.ts",
      "scripts/**/*.mjs"
    ]
  }
}
