{
  "name": "@mayjournal/fitness-checks",
  "version": "0.1.0-2026.05.20.1705",
  "description": "Default check bundle for @mayjournal/fitness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/may-journal/fitness-runner.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./defaultChecks": {
      "types": "./dist/defaultChecks.d.ts",
      "import": "./dist/defaultChecks.js",
      "default": "./dist/defaultChecks.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "fitness-shared build",
    "knip": "knip --no-exit-code",
    "prepublishOnly": "npm run build",
    "publish:ci": "npm publish"
  },
  "prettier": "@mayjournal/fitness-shared/prettier.config",
  "dependencies": {
    "@mayjournal/fitness-check-changelog": "*",
    "@mayjournal/fitness-check-changelog-updated": "*",
    "@mayjournal/fitness-check-cspell": "*",
    "@mayjournal/fitness-check-eslint": "*",
    "@mayjournal/fitness-check-markdown-front-matter": "*",
    "@mayjournal/fitness-check-markdown-no-bold-italic": "*",
    "@mayjournal/fitness-check-node-version": "*",
    "@mayjournal/fitness-check-prettier": "*",
    "@mayjournal/fitness-check-read-repo-first": "*",
    "@mayjournal/fitness-check-semantic-commit": "*",
    "@mayjournal/fitness-check-vitest-coverage-exclude": "*",
    "@mayjournal/fitness-check-vitest-coverage-full": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "restricted",
    "tag": "next"
  },
  "knip": {
    "entry": [
      "src/index.ts"
    ],
    "project": [
      "src/**/*.ts"
    ]
  }
}
