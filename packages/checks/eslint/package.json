{
  "name": "@mayjournal/fitness-check-eslint",
  "version": "0.1.0-2026.07.18.1312",
  "private": true,
  "description": "Fitness check: eslint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/may-journal/fitness-runner.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "fitness-shared build",
    "ci": "bash ../../../scripts/nvm-use/nvm-use.sh && npm run test",
    "knip": "knip --no-exit-code",
    "test": "npm run build && fitness-shared test"
  },
  "prettier": "@mayjournal/fitness-shared/prettier.config",
  "overrides": {
    "eslint-plugin-typescript-sort-keys": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "@mayjournal/fitness-shared": "*",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "^63.0.13",
    "eslint-plugin-perfectionist": "^5.9.1"
  },
  "devDependencies": {
    "@mayjournal/fitness": "*",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@mayjournal/fitness": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "knip": {
    "entry": [
      "src/index.ts",
      "src/**/*.test.ts"
    ],
    "project": [
      "src/**/*.ts"
    ]
  }
}
