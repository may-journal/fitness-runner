{
  "name": "@mayjournal/fitness-check-vitest-coverage-full",
  "version": "0.1.0-2026.05.20.1905",
  "private": true,
  "description": "Fitness check: vitest-coverage-full",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/may-journal/fitness-runner.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "fitness-shared build",
    "ci": "bash ../../../scripts/nvm-use/nvm-use.sh && npm run format:check && npm run lint && npm run test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "knip": "knip --no-exit-code",
    "lint": "fitness-shared lint",
    "test": "npm run build && fitness-shared test --coverage"
  },
  "prettier": "@mayjournal/fitness-shared/prettier.config",
  "dependencies": {
    "@mayjournal/fitness-shared": "*"
  },
  "devDependencies": {
    "@mayjournal/fitness": "*",
    "@types/node": "^25",
    "@vitest/coverage-v8": "^4.0.18",
    "prettier": "3.8.1",
    "typescript": "^5.6",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@mayjournal/fitness": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "knip": {
    "entry": [
      "src/index.ts",
      "src/**/*.test.ts"
    ],
    "project": [
      "src/**/*.ts"
    ]
  }
}
