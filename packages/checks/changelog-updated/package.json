{
  "name": "@mayjournal/fitness-check-changelog-updated",
  "version": "0.1.0-2026.05.20.1435",
  "description": "Fitness check: changelog-updated",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "ci": "bash ../../scripts/nvm-use.sh && npm run format:check && npm run lint && npm run test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "cd ../.. && tsconfig.js --once --root packages/shared/config --extensions=js,cjs --extends-strategy=ignore && eslint -c packages/shared/config/eslint.config.cjs packages/checks/changelog-updated",
    "prepublishOnly": "npm run build",
    "publish:ci": "npm publish",
    "test": "npm run build && vitest run --config vitest.config.mjs"
  },
  "prettier": "@mayjournal/fitness-shared/prettier.config",
  "dependencies": {
    "@mayjournal/fitness": "*",
    "@mayjournal/fitness-shared": "*"
  },
  "devDependencies": {
    "@types/node": "^25",
    "prettier": "3.8.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sort-json": "^4.2.0",
    "tsconfig.js": "^3.0.0",
    "typescript": "^5.6",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@mayjournal/fitness": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "restricted",
    "tag": "next"
  }
}
