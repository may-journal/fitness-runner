#!/bin/sh
# fitness/adr-0009/check: fitness keeps the org bar for itself: org policy,
# no check turned off, and no local check that replaces a bundled one.
. fitness/_lib/verdict.sh
judged
grep -q '"disabledChecks"' .fitnessrc.json && fail ".fitnessrc.json: disabledChecks turns checks off, which org policy refuses; fix the findings instead (ADR 0009, decision 8)"
grep -qE '"policy": *"external"' .fitnessrc.json && fail ".fitnessrc.json: fitness keeps org policy, so its own bar is the shared one (ADR 0009, decision 5)"
for f in $(git ls-files 'fitness/*/README.md'); do
  judged
  name=$(basename "$(dirname "$f")")
  [ -d "go/cmd/fitness-check-$name" ] && fail "fitness/$name: shares a bundled check's name, which org policy refuses to replace; give it a new name (ADR 0009, decision 5)"
done
finish
