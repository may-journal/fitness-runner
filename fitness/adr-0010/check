#!/bin/sh
# fitness/adr-0010/check: every built-in check is a package the one fitness
# binary runs, and its name list is generated.
. fitness/_lib/verdict.sh
for d in $(git ls-files 'go/cmd/fitness-check-*/*.go' | sed 's|/[^/]*$||' | sort -u); do
  judged
  grep -qs '^func Main()' "$d"/*.go || fail "$d: export func Main(), so the one fitness binary runs the check (ADR 0010, decision 1)"
done
judged
head -1 go/cmd/fitness/checks.go | grep -q 'Code generated' || fail "go/cmd/fitness/checks.go: fitness-release checks writes the check list; never keep it by hand (ADR 0010, decision 3)"
finish
