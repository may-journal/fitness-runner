#!/bin/sh
# fitness/adr-0001/check: each budget a built-in check declares names the
# external cost that needs it, and the repo raises no budget for all.
. fitness/_lib/verdict.sh
budgets=fitness/adr-0001/budgets.txt
for f in $(git ls-files 'go/cmd/fitness-check-*/main.go'); do
  judged
  ms=$(sed -n 's/.*TimeoutMs: \([0-9][0-9]*\).*/\1/p' "$f")
  [ -n "$ms" ] || continue
  name=$(basename "$(dirname "$f")")
  name=${name#fitness-check-}
  grep -q "^$name $ms " "$budgets" || fail "$f: $name declares a ${ms}ms budget that $budgets does not record; cut the work, or record the external cost that needs it (ADR 0001, decision 2)"
done
while read -r name ms _; do
  grep -qE "TimeoutMs: $ms[,}]" "go/cmd/fitness-check-$name/main.go" 2>/dev/null || fail "$budgets: $name no longer declares ${ms}ms; update or delete its line"
done <"$budgets"
judged
grep -q '"timeoutMs"' .fitnessrc.json && fail ".fitnessrc.json: timeoutMs raises the budget of every check; cut the slow work instead (ADR 0001, decision 1)"
finish
