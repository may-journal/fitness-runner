#!/bin/sh
# fitness/adr-0007/check: CHANGELOG.md stays frozen at 1.14.0, and Release
# Please writes no changelog.
. fitness/_lib/verdict.sh
judged
case "$(grep -m1 '^## \[' CHANGELOG.md)" in
"## [1.14.0]"*) ;;
*) fail "CHANGELOG.md: its newest release stays 1.14.0; release notes come from changelog/ entry files (ADR 0007, decision 6)" ;;
esac
judged
grep -q '"skip-changelog": *true' release-please-config.json || fail "release-please-config.json: set skip-changelog to true, so no release writes CHANGELOG.md (ADR 0007, decision 4)"
finish
