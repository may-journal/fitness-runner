#!/bin/sh
# fitness/adr-0003/check: each workflow job that runs steps writes a job
# summary.
. fitness/_lib/verdict.sh
for f in $(git ls-files '.github/workflows/*.yml'); do
  judged
  jobs=$(grep -c '^ *steps:' "$f")
  summaries=$(grep -c 'GITHUB_STEP_SUMMARY' "$f")
  [ "$summaries" -ge "$jobs" ] || fail "$f: $jobs jobs run steps, and only $summaries lines write GITHUB_STEP_SUMMARY; give each job a summary (ADR 0003, decision 4)"
done
finish
