#!/bin/sh
# fitness/adr-0002/check: no code, config or hook names a second lint path
# beside the eslint check.
. fitness/_lib/verdict.sh
second="fitness-shared"" lint"
for f in $(git ls-files -- '*.go' '*.json' '*.yml' '*.yaml' '*.js' '*.mjs' '*.cjs' '*.ts' '*.sh' 'githooks/*'); do
  judged
  grep -qF "$second" "$f" && fail "$f: names a second lint path, $second; the eslint check owns the one lint config (ADR 0002)"
done
finish
