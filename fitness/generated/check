#!/bin/sh
# Local fitness check: fails when a file `go generate` writes from the code
# is stale or edited by hand. See fitness/generated/README.md.
set -eu
if [ "${1:-}" = "--describe" ]; then
  # The same handshake fitness-release gives, answered here because compiling
  # that tool can outlast the handshake's 2-second budget.
  echo '{"name":"generated","summary":"Fails when a file `go generate` writes from doc comments is stale, or a check package has no doc comment.","scope":"files","timeoutMs":120000}'
  exit 0
fi
exec go -C "$(dirname "$0")/../../go" run ./cmd/fitness-release generated "$@"
