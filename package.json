{
  "name": "fitness-runner",
  "version": "0.1.0-2026.07.02.2234",
  "private": true,
  "description": "Monorepo for @mayjournal/fitness runner and check packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/may-journal/fitness-runner.git"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/runner",
    "packages/shared",
    "packages/checks-bundle",
    "packages/checks/*"
  ],
  "scripts": {
    "audit:publish": "node scripts/audit-publish/index.mjs",
    "bench:load-check": "npm run bench -w @mayjournal/fitness",
    "build": "npm run build -w @mayjournal/fitness-shared && npm run build -ws --if-present",
    "ci": "npm run ci -w @mayjournal/fitness",
    "fitness": "npm run build -w @mayjournal/fitness && node packages/runner/bin/fitness.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "knip": "npm run knip -ws --if-present",
    "lint": "npm run lint -w @mayjournal/fitness",
    "precommit": "npm run fitness && npm run lint",
    "prepare": "test -d .git && git config core.hooksPath githooks || true",
    "provision:npm": "node scripts/provision-npm-packages/index.mjs",
    "publish:ci": "npm publish -w @mayjournal/fitness-shared --access public; npm publish -w @mayjournal/fitness-checks --access public; npm publish -w @mayjournal/fitness --access public",
    "test": "npm run test -w @mayjournal/fitness",
    "test:scripts": "node --test scripts/audit-publish/index.test.mjs scripts/list-publishable-packages/index.test.mjs scripts/provision-npm-packages/index.test.mjs scripts/provision-npm-packages/trust-github-api.test.mjs scripts/ensure-changelog-timestamp/index.test.mjs scripts/nvm-use/nvm-use.test.mjs scripts/setup-githooks.test.mjs scripts/setup-npm-trusted-publishers/index.test.mjs"
  },
  "prettier": "@mayjournal/fitness-shared/prettier.config",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@mayjournal/fitness": "*",
    "@mayjournal/fitness-checks": "*",
    "@mayjournal/fitness-shared": "*",
    "knip": "^5.88.1",
    "prettier": "3.8.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sort-json": "^4.2.0",
    "publint": "^0.3.12"
  },
  "engines": {
    "node": ">=24"
  }
}
