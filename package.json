{
  "name": "@fitness/runner",
  "version": "0.1.0-2026.02.15.1100",
  "description": "Fitness runner for rules: CI/CD and GenAI guardrails",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "fitness": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "conventional-commit-types": "^3.0.0",
    "cspell": "^8.15.0",
    "jiti": "^2.6.1"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "ci": "(nvm use 2>/dev/null || true) && npm run fitness && npm run lint && npm test",
    "fitness": "npm run build && node dist/index.js",
    "lint": "eslint .",
    "precommit": "npm run fitness",
    "prepare": "husky",
    "test": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.8.0",
    "@types/node": "^25",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "eslint-plugin-jsdoc": "^62.5.4",
    "husky": "^9.0.0",
    "jiti": "^2.6.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6",
    "vitest": "^2.0"
  }
}
