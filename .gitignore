# Node and npm debug logs from failed installs or scripts
*.log
# npm's own debug log files
npm-debug.log*

# Installed dependencies; restored by `npm install`, never committed
node_modules/

# Vitest/istanbul coverage output, regenerated per run
coverage
# Per-file lcov coverage reports
*.lcov
# nyc coverage instrumentation data
.nyc_output

# TypeScript build output; published from dist/, never source-controlled
dist
# TypeScript incremental build cache (machine-local)
*.tsbuildinfo

# npm cache dir when npm uses a project-local cache
.npm
# ESLint result cache (machine-local; speeds reruns)
.eslintcache

# Local environment variables and secrets
.env
# Per-environment env files (also secret)
.env.*
# Keep the committed, non-secret template
!.env.example

# `npm pack` tarballs produced by publish/audit tooling
*.tgz

# Vite/Vitest config timestamp sidecars written during runs
vite.config.js.timestamp-*
# TypeScript variant of the same sidecar
vite.config.ts.timestamp-*

# Compiled JS emitted into src during builds (source of truth is dist/)
src/**/*.js
# ...and their sourcemaps
src/**/*.js.map

# tsconfig.json is generated by tsconfig.js (sources are *.cjs)
tsconfig.json
# ...except the hand-authored shared package tsconfig
!packages/shared/tsconfig.json
# ...and the hand-authored check package tsconfigs
!packages/checks/*/tsconfig.json
# ...and the hand-authored bundle tsconfig
!packages/checks-bundle/tsconfig.json
# Generated build tsconfig (tsconfig.js output)
build/tsconfig.json
# Generated shared check tsconfig (source is tsconfig.check.cjs)
packages/shared/config/tsconfig.check.json

# Compiled eslint config (source is eslint.config.mjs)
eslint.config.js
# ...and its sourcemap
eslint.config.js.map
# Compiled prettier config (source is prettier.config.cjs)
prettier.config.js
# ...and its sourcemap
prettier.config.js.map
# ...and its declaration sourcemap
prettier.config.d.ts.map
# Compiled vitest config (source is vitest.config.ts)
vitest.config.js
# ...and its sourcemap
vitest.config.js.map
# Generated vitest config declaration at repo root
/vitest.config.d.ts
# ...and its sourcemap
vitest.config.d.ts.map
# ...except the hand-authored vitest type shim
!packages/shared/types/vitest.config.d.ts

# Compiled Go binaries; rebuilt from go/ sources, never committed
go/bin/
