# Logs from failed tool runs or scripts
*.log

# Legacy build-output dir name; also asserted ignored by the build-output-untracked check
dist

# Local environment variables and secrets
.env
# Per-environment env files (also secret)
.env.*

# Compiled Go binaries; rebuilt from go/ sources, never committed
go/bin/

# macOS Finder view-state metadata; never part of the project
.DS_Store

# Release archives and installer, rebuilt by the packaging script
out/


# Local builds of the fitness binaries, made while checking work before a commit
.build/

# `go build` in an ADR check folder writes a binary named for it; fitness builds into its cache
/fitness/*/adr-[0-9][0-9][0-9][0-9]
# `go build` in a requirement check folder writes a binary named for it, never committed
/fitness/*/req-[0-9][0-9][0-9][0-9]
# `go build` in the generated check folder writes its binary here, never committed
/fitness/generated/generated
